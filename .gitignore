# secrets
.env
.env.local
*.pem
*.key
# The credential master key decrypts every provider_credentials row.
# Belt and braces: dev scripts now write it into .env, but never let a stray
# sidecar file be stageable.
.dev_enc_key
**/.dev_enc_key
*_enc_key

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# node
node_modules/
.next/
out/
*.tsbuildinfo

# go
/gateway/bin/
/user-svc/bin/
/conv-svc/bin/
/gateway/gateway
/user-svc/user-svc
/conv-svc/conv-svc
*.exe

# data
volumes/
*.db

# whatsapp bridge session — the Baileys auth state IS a login credential.
whatsapp-bridge/data/
whatsapp-bridge/auth/

# editors / os
.DS_Store
Thumbs.db
# Per-machine Claude Code settings (absolute paths). Shared config belongs
# in .claude/settings.json; workflows in .claude/workflows/ are tracked.
.claude/settings.local.json

# runtime
logs/

# Playwright responsive screenshots (scripts/shots.mjs writes here)
web/shots/

# Local DB safety dumps taken before destructive memory edits
backups/
