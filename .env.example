# Copy to .env and fill in. .env is gitignored. Never commit real values.

# ---- infrastructure -------------------------------------------------------
# Port 5433, not 5432: an unrelated hotel_bookings_db container owns 5432.
DATABASE_URL=postgresql://raphael:raphael@localhost:5433/raphael
REDIS_URL=redis://localhost:6379/0

# ---- service ports --------------------------------------------------------
GATEWAY_PORT=8080
USER_SVC_PORT=8081
CONV_SVC_PORT=8082
AGENT_SVC_PORT=8000

# ---- internal service URLs (server-to-server) -----------------------------
USER_SVC_URL=http://localhost:8081
CONV_SVC_URL=http://localhost:8082
AGENT_SVC_URL=http://localhost:8000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# ---- auth -----------------------------------------------------------------
# Dev-mode only. Walking skeleton: /auth/dev-login mints a JWT for a seeded user.
JWT_SECRET=dev-only-change-me
DEV_AUTH_ENABLED=true

# ---- credential encryption ------------------------------------------------
# 32 raw bytes, base64-encoded. Encrypts provider_credentials.api_key_enc (AES-256-GCM).
# Generate: openssl rand -base64 32
CREDENTIAL_ENC_KEY=

# ---- internal service auth ------------------------------------------------
# Shared secret guarding user-svc /internal/* (which returns decrypted keys).
# agent-svc sends it as X-Internal-Token. Any long random string. Must match
# between user-svc and agent-svc. Generate: openssl rand -hex 32
INTERNAL_TOKEN=

# ---- embeddings (in-process, no network) ----------------------------------
# Dimensions are not configurable: 768 is baked into config.py and the
# vector(768) column in db/001_init.sql. A different model needs a migration.
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# ---- local model ----------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
# Host port the compose Ollama publishes. Set to 11435 if your host already runs
# Ollama on 11434 (avoids the bind clash without a separate compose file).
OLLAMA_HOST_PORT=11434

# ---- optional providers ----------------------------------------------------
# No provider API keys here: credentials live per-user in provider_credentials
# (encrypted), added through the UI. Only the default base URL is config.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
