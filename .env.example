# Copy to .env and fill in. .env is gitignored. Never commit real values.

# ---- infrastructure -------------------------------------------------------
# Port 5433, not 5432: an unrelated hotel_bookings_db container owns 5432.
DATABASE_URL=postgresql://raphael:raphael@localhost:5433/raphael
REDIS_URL=redis://localhost:6379/0

# ---- service ports --------------------------------------------------------
GATEWAY_PORT=8080
USER_SVC_PORT=8081
CONV_SVC_PORT=8082
AGENT_SVC_PORT=8000

# ---- internal service URLs (server-to-server) -----------------------------
USER_SVC_URL=http://localhost:8081
CONV_SVC_URL=http://localhost:8082
AGENT_SVC_URL=http://localhost:8000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# ---- logging --------------------------------------------------------------
# debug|info|warn|error (default info). All four services log JSON to stdout
# with the same field names; debug also surfaces /health probe lines.
LOG_LEVEL=info

# ---- auth -----------------------------------------------------------------
# Google Sign-In is the only login path; JWT_SECRET signs the access tokens.
JWT_SECRET=dev-only-change-me

# ---- credential encryption ------------------------------------------------
# 32 raw bytes, base64-encoded. Encrypts provider_credentials.api_key_enc (AES-256-GCM).
# Generate: openssl rand -base64 32
CREDENTIAL_ENC_KEY=

# ---- internal service auth ------------------------------------------------
# Shared secret guarding user-svc /internal/* (which returns decrypted keys).
# agent-svc sends it as X-Internal-Token. Any long random string. Must match
# between user-svc and agent-svc. Generate: openssl rand -hex 32
INTERNAL_TOKEN=

# ---- embeddings (in-process, no network) ----------------------------------
# Dimensions are not configurable: 768 is baked into config.py and the
# vector(768) column in db/001_init.sql. A different model needs a migration.
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# ---- local model ----------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
# Host port the compose Ollama publishes. Set to 11435 if your host already runs
# Ollama on 11434 (avoids the bind clash without a separate compose file).
OLLAMA_HOST_PORT=11434
# MUST match your server's real OLLAMA_CONTEXT_LENGTH / Modelfile num_ctx. No
# endpoint reports it for a cold model, so this is the only authority: too low
# just wastes window, too high makes Ollama truncate in silence.
OLLAMA_NUM_CTX=4096

# ---- optional providers ----------------------------------------------------
# No provider API keys here: credentials live per-user in provider_credentials
# (encrypted), added through the UI. Only the default base URL is config.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- web search (optional) -------------------------------------------------
# Operator-wide key, not a per-user credential. Empty = search off entirely:
# the tool is never registered and no query leaves the box.
# Get one: https://brave.com/search/api/
BRAVE_API_KEY=
# The entire egress surface. Point at your own SearxNG to keep queries local.
SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search

# ---- google connectors (optional) -----------------------------------------
# No-CASA scopes only (Calendar read-only + profile) — keeps verification light.
# Empty = the connector is off (no Connect button, no OAuth routes exercised).
# Get credentials from a Google Cloud project's OAuth consent screen in Testing
# mode. GOOGLE_REDIRECT_URI must match EXACTLY what's registered in the OAuth
# client (gateway builds the consent URL with it; user-svc reuses it on exchange).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# ---- whatsapp bridge (optional, opt-in) -----------------------------------
# UNOFFICIAL WhatsApp Web library — CAN GET THE NUMBER BANNED. Single-user
# personal use only. Runs behind the `whatsapp` compose profile (skipped by a
# plain `docker compose up`). See whatsapp-bridge/README.md before enabling.
# Owner's WhatsApp JID: number in international format (no +), then @s.whatsapp.net
WHATSAPP_OWNER_JID=
# Owner's Raphael user uuid (the account replies are attributed to).
WHATSAPP_OWNER_USER_ID=

# ---- mail intelligence (optional) -----------------------------------------
# Gmail sync + local classification + Gmail labels. Empty/unset = the worker
# thread never starts and no Gmail call is ever made. Each user ALSO has to
# switch it on in Settings (mail_config.enabled), so this is the operator half
# of a two-key switch.
#
# Requires db/019_mail.sql applied, and the Google OAuth client re-consented
# with gmail.modify (see gateway/google.go). gmail.modify is the minimum that
# reads bodies, creates labels and applies them — and it CANNOT permanently
# delete mail, which is why it is the ceiling rather than mail.google.com.
#
# Publish the OAuth consent screen to "In production" (verification is not
# required for personal use). Leaving it in "Testing" issues refresh tokens
# that expire after 7 DAYS, which no unattended worker survives.
MAIL_ENABLED=
# How often to poll Gmail. users.history.list costs 2 quota units against a
# 6,000-units-per-MINUTE budget, so 300s spends ~576 units/day. Hourly polling
# would save nothing and only add latency.
MAIL_POLL_SECONDS=300
# One-time historical import window, and how many messages one tick processes.
MAIL_BACKFILL_DAYS=90
MAIL_BATCH_SIZE=25
# Gmail label namespace: <prefix>/Act now, <prefix>/FYI, ... alongside Topic/*.
MAIL_LABEL_PREFIX=Assistant
# Optional pin for the classifier model. Empty = whatever the active local
# credential specifies. A 2-4B instruct model is the right size here; measured,
# a 2B matched a 9B's labels at 2.6x the speed.
# DO NOT use an "-mlx" tag: that runner silently ignores JSON schemas.
MAIL_MODEL=
# THE PRIVACY SWITCH. false (default) = classification uses a LOCAL provider or
# does not happen at all, so email bodies never leave this machine. The lifeboat
# is deliberately NOT consulted for mail — it is designed to be a cloud provider.
# Setting this true is an explicit decision to send private email to a remote API.
MAIL_ALLOW_CLOUD_CLASSIFIER=false

# ---- telegram notifications (optional) ------------------------------------
# The first outbound delivery adapter for the notifications table. Empty = the
# delivery goroutine never starts and notifications stay in the in-app bell,
# exactly as they do today.
#
# Get a token from @BotFather (/newbot). A bot CANNOT start a conversation, so
# you must message it once yourself first; then read your chat id from
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" | jq '.result[].message.chat.id'
# and paste it into Settings. The chat id is per-user config, not deployment
# config, so it lives in the database rather than here.
#
# The token is full control of the bot: never commit it, never log it. Rotate
# with /token in BotFather.
TELEGRAM_BOT_TOKEN=
